# Copy to .env and fill in when you want real generation.
# .env is gitignored - never commit real keys.

# Provider selection: mock | gemini | huggingface
PROVIDER=mock
USE_MOCK_PROVIDER=true

# Hugging Face (free IDM-VTON Space) - token from https://huggingface.co/settings/tokens
# Optional: with no token the backend uses the anonymous guest quota pool.
HF_TOKEN=hf_your_read_token
HF_SPACE=yisol/IDM-VTON
HF_DENOISE_STEPS=30

# Gemini - key from https://aistudio.google.com/apikey
# Note: image generation needs a billed project; the free tier returns HTTP 429.
GEMINI_API_KEY=your_key_here
GEMINI_MODEL=gemini-2.5-flash-image

BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000

# --- Security -------------------------------------------------------------
# Browser origins allowed to call the API (supports * wildcards).
ALLOWED_ORIGINS=chrome-extension://*,http://localhost:*,http://127.0.0.1:*

# Hosts the server may fetch product images from. Comma-separated.
# Leave empty to allow any public host (private/loopback IPs stay blocked).
ALLOWED_IMAGE_HOSTS=m.media-amazon.com,images-na.ssl-images-amazon.com,images-eu.ssl-images-amazon.com,images-fe.ssl-images-amazon.com

# --- Limits ---------------------------------------------------------------
MAX_IMAGE_BYTES=8388608
MAX_IMAGE_SIDE=1024
FETCH_TIMEOUT_MS=15000

# Result cache. Protects the shared GPU quota from repeated identical requests.
# Set CACHE_MAX_ENTRIES=0 to disable caching (coalescing still applies).
CACHE_MAX_ENTRIES=32
CACHE_TTL_MS=3600000
